diff --git a/pyproject.toml b/pyproject.toml
index 8b30d87..419b5dc 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -7,7 +7,9 @@ authors = [
     { name = "Jordi Marsal", email = "jordi.marsal@gmail.com" }
 ]
 requires-python = ">=3.14"
-dependencies = []
+dependencies = [
+    "mcp>=2.3,<3",
+]
 
 [project.scripts]
 debrief = "debrief:main"
@@ -18,5 +20,21 @@ build-backend = "uv_build"
 
 [dependency-groups]
 dev = [
+    "mypy>=1.15",
     "pytest>=9.2.0",
+    "ruff>=0.14",
 ]
+
+[tool.ruff]
+line-length = 100
+target-version = "py314"
+# harness/tools are harness-owned scripts executed by the system python3 (<3.14),
+# so py314-only syntax ruff formats towards must never be applied to them.
+extend-exclude = ["harness/tools"]
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "I", "UP", "B"]
+
+[tool.mypy]
+strict = true
+files = ["src", "tests"]
diff --git a/src/debrief/__init__.py b/src/debrief/__init__.py
index 3fbbf24..7608a96 100644
--- a/src/debrief/__init__.py
+++ b/src/debrief/__init__.py
@@ -1,2 +1,16 @@
-def main() -> None:
-    print("Hello from debrief!")
+"""debrief — answers agent questions from receipts; never writes (ADR-0001)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+__all__ = ["main"]
+
+
+def __getattr__(name: str) -> Any:
+    # Lazy on purpose: `import debrief` (and so debrief.domain) must not pull in the mcp SDK.
+    if name == "main":
+        from debrief.mcp_server import main
+
+        return main
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")